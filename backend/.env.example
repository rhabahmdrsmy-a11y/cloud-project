# انسخي الملف ده باسم .env وعدّلي القيم
PORT=5000

# محلي:
MONGODB_URI=mongodb://127.0.0.1:27017/sphinx_feedback
# أو MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sphinx_feedback

# الدومينات المسموح لها تكلم الـ API (مفصولة بفاصلة). سيبيها فاضية في التطوير = الكل مسموح
# CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# مكان ملفات الفرونت (index.html ...). الافتراضي: الفولدر اللي جواه فولدر backend. غالبًا مش محتاجة تغيريه
# FRONTEND_DIR=..

# لما ترفعيه على استضافة (Render/Railway...) خليه 1
# TRUST_PROXY=1

# لو حطيتي مفتاح هنا، كل GET /api/feedback* هيحتاج header اسمه x-api-key
# (سيبيه فاضي دلوقتي لأن الداشبورد مفيهاش login لسه)
ADMIN_API_KEY=
